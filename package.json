{
  "name": "openchamber-todo-bridge",
  "version": "0.9.3",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Shows the OpenCode session todo list in OpenChamber's Work Status panel.",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.0.4"
    },
    "contributes": {
      "panel": {
        "id": "todo-bridge",
        "name": "Todos",
        "icon": "checkbox-circle",
        "entry": "panel/index.html"
      },
      "page": {
        "entry": "board/index.html",
        "title": "任务图"
      },
      "capabilities": ["sessions"],
      "statusSection": {
        "entry": "status/index.html",
        "title": "Todos",
        "height": 56
      },
      "filesystem": [
        "~/.config/openchamber/todos/*.json",
        "~/.config/opencode/plugins/openchamber-todo-bridge/*"
      ]
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "test-extension": "bun run scripts/build-test-extension.ts",
    "validate": "bun run scripts/validate.ts",
    "test": "node scripts/test-plugin.mjs && node scripts/test-context.mjs && node scripts/test-viewport.mjs && node scripts/test-graph.mjs && node scripts/test-dag.mjs && node scripts/test-index.mjs && node scripts/test-archive.mjs && node scripts/test-install.mjs"
  },
  "devDependencies": {
    "@openchamber/sdk": "^2.0.4"
  }
}
